<UserControl x:Class="TiendaApp.Views.VentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="410"/>
        </Grid.ColumnDefinitions>

        <!-- ============ CATÁLOGO ============ -->
        <DockPanel Margin="0,0,20,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
                <materialDesign:PackIcon Kind="CashRegister" Width="32" Height="32"
                                         Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                <TextBlock Text="Cobrar" FontSize="28" FontWeight="Bold" Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBox DockPanel.Dock="Top"
                     materialDesign:HintAssist.Hint="Buscar producto o categoría..."
                     Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Catalogo}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Width="175" Margin="0,0,14,14" UniformCornerRadius="14">
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Height="Auto" Padding="14"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                                        Foreground="{DynamicResource MaterialDesignBody}"
                                        materialDesign:ButtonAssist.CornerRadius="14"
                                        Command="{Binding DataContext.AgregarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <materialDesign:PackIcon Kind="PackageVariantClosed" Width="30" Height="30"
                                                                 Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="15"
                                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding Categoria}" Opacity="0.6" FontSize="12"/>
                                        <TextBlock Text="{Binding Precio, StringFormat={}{0:C2}}" FontSize="20"
                                                   FontWeight="Bold" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                        <TextBlock Text="{Binding Stock, StringFormat=Stock: {0}}" Opacity="0.6" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- ============ CUENTA / COBRO ============ -->
        <materialDesign:Card Grid.Column="1" UniformCornerRadius="16" Padding="20">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Cuenta actual" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding TotalArticulos, StringFormat={}{0} artículo(s)}"
                           Opacity="0.6" Margin="0,0,0,8"/>

                <!-- Total, pago y botones -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Margin="0,8,0,12"/>

                    <DockPanel>
                        <TextBlock Text="TOTAL" FontSize="16" VerticalAlignment="Center" Opacity="0.7"/>
                        <TextBlock Text="{Binding Total, StringFormat={}{0:C2}}" FontSize="38" FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                    </DockPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox materialDesign:HintAssist.Hint="El cliente paga con"
                                 materialDesign:TextFieldAssist.PrefixText="$"
                                 Text="{Binding PagoTexto, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="18"/>
                        <Button Grid.Column="1" Content="EXACTO" Margin="10,0,0,0" Height="Auto" Padding="14,12"
                                Command="{Binding PagoExactoCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8"/>
                    </Grid>

                    <DockPanel Margin="0,14,0,16">
                        <TextBlock Text="CAMBIO" FontSize="16" VerticalAlignment="Center" Opacity="0.7"/>
                        <TextBlock Text="{Binding Cambio, StringFormat={}{0:C2}}" FontSize="26" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" Foreground="#66BB6A"/>
                    </DockPanel>

                    <Button Content="COBRAR E IMPRIMIR TICKET" Command="{Binding CobrarCommand}"
                            Height="52" FontSize="15"
                            Background="#43A047" BorderBrush="#43A047"
                            materialDesign:ButtonAssist.CornerRadius="12"/>
                    <Button Content="VACIAR CUENTA" Command="{Binding VaciarCommand}" Margin="0,8,0,0"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="12"/>
                </StackPanel>

                <!-- Lista de artículos -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Carrito}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="82"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Producto.Nombre}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Producto.Precio, StringFormat={}{0:C2} c/u}"
                                                   Opacity="0.6" FontSize="12"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Width="28" Height="28"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.MenosCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Minus"/>
                                        </Button>
                                        <TextBlock Text="{Binding Cantidad}" Width="26" TextAlignment="Center"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Width="28" Height="28"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.MasCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Plus"/>
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Subtotal, StringFormat={}{0:C2}}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>

                                    <Button Grid.Column="3" Width="28" Height="28" Margin="4,0,0,0"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Foreground="#EF5350"
                                            Command="{Binding DataContext.QuitarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="Delete"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
