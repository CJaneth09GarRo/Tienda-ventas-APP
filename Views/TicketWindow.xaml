<Window x:Class="TiendaApp.Views.TicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Ticket de venta" Height="640" Width="470"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Segoe UI">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="IMPRIMIR" Click="Imprimir_Click" Margin="0,0,8,0"
                    materialDesign:ButtonAssist.CornerRadius="10"/>
            <Button Content="ABRIR CARPETA" Click="Carpeta_Click" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    materialDesign:ButtonAssist.CornerRadius="10"/>
            <Button Content="CERRAR" Click="Cerrar_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    materialDesign:ButtonAssist.CornerRadius="10"/>
        </StackPanel>

        <!-- Aspecto de papel de ticket -->
        <materialDesign:Card UniformCornerRadius="6" Padding="20" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtTicket" FontFamily="Consolas" FontSize="13" Foreground="Black"/>
            </ScrollViewer>
        </materialDesign:Card>
    </DockPanel>
</Window>
