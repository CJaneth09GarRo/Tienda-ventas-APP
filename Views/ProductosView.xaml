<UserControl x:Class="TiendaApp.Views.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,20">
            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="32" Height="32"
                                     Foreground="{DynamicResource SecondaryHueMidBrush}"/>
            <TextBlock Text="Productos" FontSize="28" FontWeight="Bold" Margin="12,0,0,0"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <materialDesign:Card Padding="20" Margin="0,0,20,0" UniformCornerRadius="14" VerticalAlignment="Top">
                <StackPanel>
                    <TextBox materialDesign:HintAssist.Hint="Nombre"
                             Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="Categoría"
                             Text="{Binding Categoria, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="Precio"
                             materialDesign:TextFieldAssist.PrefixText="$"
                             Text="{Binding Precio}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="Stock"
                             Text="{Binding Stock}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,20"/>

                    <Button Content="GUARDAR" Command="{Binding GuardarCommand}" Margin="0,0,0,8"
                            materialDesign:ButtonAssist.CornerRadius="10"/>
                    <Button Content="NUEVO" Command="{Binding LimpiarCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,8"
                            materialDesign:ButtonAssist.CornerRadius="10"/>
                    <Button Content="ELIMINAR" Command="{Binding EliminarCommand}"
                            Background="#E53935" BorderBrush="#E53935"
                            materialDesign:ButtonAssist.CornerRadius="10"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="1" UniformCornerRadius="14" Padding="8">
                <DataGrid ItemsSource="{Binding Productos}" SelectedItem="{Binding Seleccionado}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          materialDesign:DataGridAssist.CellPadding="12" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat={}{0:C2}}" Width="110"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>
    </DockPanel>
</UserControl>
